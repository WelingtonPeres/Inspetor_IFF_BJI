/* 
============================================================
   style.qss — Tema Dark (Dart)
   Baseado no DESIGN.md — Dark Mode
============================================================ 
*/

/* --- Janela Principal --- */
QMainWindow {
    background-color: #121414;
}

QStackedWidget {
    background-color: #121414;
}

/* --- Labels de Título --- */
#titulo_menu {
    color: #71dd77;
    font-family: "Open Sans";
    font-size: 32px;
    font-weight: 700;
    padding: 24px;
}

#label_selecao_perfil {
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 20px;
    font-weight: 700;
}

/* --- Bloco de Informações do Relatório (Inspeção) --- */
#info_block_relatorio {
    background-color: transparent;
    border: none;
}

#info_block_relatorio .label_info_valor {
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 14px;
    font-weight: 400;
    padding: 4px 0 0 0;
}

#label_info_descricao {
    font-size: 16px;
    font-weight: 500;
}

#label_info_titulo {
    color: #71dd77;
    font-family: "Open Sans";
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
}

/* --- Labels de Feedback (Diagnóstico / Resultado) --- */
.label_feedback {
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 14px;
    font-weight: 400;
    padding: 24px;
    background-color: #1e2020;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
}

/* --- Botões Primários --- */
.btn_primario {
    background-color: #2F9E41;
    color: #FFFFFF;
    font-family: "Open Sans";
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 4px;
    padding: 10px 24px;
    min-width: 160px;
}

.btn_primario:hover {
    background-color: #37a547;
}

.btn_primario:pressed {
    background-color: #006e22;
}

/* --- Group Boxes (Inspeção) --- */
.group_box {
    background-color: #1e2020;
    border: 1px solid #3f4a3d;
    border-bottom: 3px solid #0c0f0f;
    border-right: 3px solid #0c0f0f;
    border-radius: 4px;
    color: #71dd77;
    font-family: "Open Sans";
    font-size: 14px;
    font-weight: 700;
    padding: 20px 12px 12px 12px;
    margin: 8px 0;
}

.group_box::title {
    background-color: #37a547;
    color: #00320a;
    padding: 6px 14px;
    border-radius: 4px;
    subcontrol-origin: margin;
    left: 12px;
}

/* --- Tactile Tile — Fator (QPushButton com layout interno) --- */
QPushButton[class="fator_tile"] {
    border: 2px solid #ffffff;
    border-radius: 8px;
    padding: 10px 14px;
    min-height: 80px;
    background-color: transparent;
    color: #ffffff;
    font-family: "Open Sans";
}

QPushButton[class="fator_tile"]:hover {
    border-color: #ffffff;
}

QPushButton[class="fator_tile"]:checked {
    background-color: #569ba1;
    border-color: #569ba1;
    color: #002f32;
}

QPushButton[class="fator_tile"]:checked:hover {
    background-color: #387f84;
    border-color: #387f84;
    color: #002f32;
}

QPushButton[class="fator_tile"]:focus {
    border-color: #ffffff;
    outline: none;
}

QLabel[class="fator_titulo"] {
    color: #ffffff;
    font-family: "Open Sans";
    font-size: 16px;
    font-weight: 700;
}

QPushButton[class="fator_tile"]:checked QLabel[class="fator_titulo"] {
    color: #002f32;
}

QLabel[class="fator_subtitulo"] {
    color: #ffffff;
    font-family: "Open Sans";
    font-size: 13px;
    font-weight: 400;
}

QPushButton[class="fator_tile"]:checked QLabel[class="fator_subtitulo"] {
    color: #002f32;
}

/* --- Tactile Tile — Risco (QToolButton grid) --- */
QToolButton[riscoTile="true"] {
    border-radius: 8px;
    padding: 8px 4px;
    min-width: 96px;
    min-height: 96px;
    font-family: "Open Sans";
    font-size: 12px;
    font-weight: 700;
    background-color: transparent;
}

QToolButton[objectName="tile_risco_FISICO"] {
    border: 2px solid #37a547;
    color: #71dd77;
}
QToolButton[objectName="tile_risco_FISICO"]:checked {
    background-color: #37a547;
    color: #ffffff;
}
QToolButton[objectName="tile_risco_FISICO"]:hover {
    border-color: #71dd77;
}

QToolButton[objectName="tile_risco_QUIMICO"] {
    border: 2px solid #bb0213;
    color: #ffb4ab;
}
QToolButton[objectName="tile_risco_QUIMICO"]:checked {
    background-color: #bb0213;
    color: #ffffff;
}
QToolButton[objectName="tile_risco_QUIMICO"]:hover {
    border-color: #ffb4ab;
}

QToolButton[objectName="tile_risco_BIOLOGICO"] {
    border: 2px solid #6d4c41;
    color: #d7ccc8;
}
QToolButton[objectName="tile_risco_BIOLOGICO"]:checked {
    background-color: #6d4c41;
    color: #ffffff;
}
QToolButton[objectName="tile_risco_BIOLOGICO"]:hover {
    border-color: #d7ccc8;
}

QToolButton[objectName="tile_risco_ERGONOMICO"] {
    border: 2px solid #d9a824;
    color: #f3d78a;
}
QToolButton[objectName="tile_risco_ERGONOMICO"]:checked {
    background-color: #d9a824;
    color: #1a1c1c;
}
QToolButton[objectName="tile_risco_ERGONOMICO"]:hover {
    border-color: #f3d78a;
}

QToolButton[objectName="tile_risco_ACIDENTE"] {
    border: 2px solid #1565c0;
    color: #8dd2d8;
}
QToolButton[objectName="tile_risco_ACIDENTE"]:checked {
    background-color: #1565c0;
    color: #ffffff;
}
QToolButton[objectName="tile_risco_ACIDENTE"]:hover {
    border-color: #8dd2d8;
}

QToolButton[riscoTile="true"]:focus {
    outline: none;
    border-style: dashed;
}

/* --- ComboBox (Seleção de Perfil) --- */
.combo_padrao {
    background-color: #121414;
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 14px;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
    padding: 8px 16px;
    min-width: 240px;
}

.combo_padrao:hover {
    border-color: #2F9E41;
}

.combo_padrao::drop-down {
    border: none;
    width: 28px;
}

.combo_padrao QAbstractItemView {
    background-color: #1e2020;
    color: #e2e2e2;
    border: 1px solid #3f4a3d;
    selection-background-color: #2F9E41;
    selection-color: #FFFFFF;
}

/* --- Popup de Erro --- */
QMessageBox {
    background-color: #1e2020;
    color: #e2e2e2;
    font-family: "Open Sans";
}

QMessageBox QLabel {
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 14px;
}

QMessageBox QPushButton {
    background-color: #CD191E;
    color: #FFFFFF;
    font-family: "Open Sans";
    font-weight: 700;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #bb0213;
}

/* =============================================================
   OVERLAYS (z-order)
   ============================================================= */

/* --- Overlay Area --- */
QWidget#overlay_area {
    background-color: transparent;
}

/* --- Taskbar (z=0) --- */
QFrame#taskbar {
    background-color: #121414;
    border: none;
    border-top: 1px solid #3f4a3d;
}

QLabel#taskbar_start {
    background-color: transparent;
    border: none;
}

QLabel#taskbar_clock {
    color: #e2e2e2;
    font-family: "Open Sans";
}

QFrame#separator_green {
    background-color: #2F9E41;
    border: none;
    max-width: 2px;
}

QFrame#separator_red {
    background-color: #CD191E;
    border: none;
    max-width: 2px;
}

/* --- Desktop (z=1) --- */
QWidget#tela_menu_principal {
    background-color: transparent;
}

QLabel#wallpaper_label {
    background-color: #121414;
}

QFrame#desktop_shortcut {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 8px;
}

QFrame#desktop_shortcut:hover {
    background-color: rgba(47, 158, 65, 0.15);
}

QLabel#shortcut_icon {
    color: #e2e2e2;
}

QLabel#shortcut_label {
    color: #e2e2e2;
    padding: 2px 4px;
}

/* --- JanelaSistema (z=2, floating) --- */
QFrame#janela_sistema {
    background-color: #1e2020;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
}

QFrame#window_title_bar {
    background-color: #21262D;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom: 2px solid #2F9E41;
}

QLabel#window_title_text {
    color: #58A6FF;
    font-family: "Courier New", Consolas, monospace;
    font-weight: bold;
    padding: 4px 8px;
}

QPushButton#window_minimize_button,
QPushButton#window_maximize_button,
QPushButton#window_close_button {
    background-color: transparent;
    color: #E6EDF3;
    border: none;
    border-radius: 0px;
    font-size: 16px;
    min-width: 36px;
    min-height: 28px;
}

QPushButton#window_minimize_button:hover {
    background-color: #484F58;
}

QPushButton#window_maximize_button:hover {
    background-color: #2F9E41;
}

QPushButton#window_close_button:hover {
    background-color: #CD191E;
    color: #FFFFFF;
}

QFrame#janela_sistema_body {
    background-color: #1e2020;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

QLabel#janela_sistema_placeholder {
    color: #5e7a72;
    font-family: "Open Sans";
}

/* --- TelaInspecaoCheia (z=2, fullscreen) --- */
QFrame#tela_inspecao_cheia {
    background-color: #121414;
}

QFrame#header_bar {
    background-color: #121414;
    border-bottom: 1px solid #3f4a3d;
}

QLabel#header_title {
    color: #71dd77;
    font-size: 14px;
    font-weight: bold;
    font-family: "Open Sans";
}

QPushButton#minimizar_button {
    background-color: transparent;
    color: #e2e2e2;
    border: none;
    font-size: 18px;
    min-width: 32px;
    min-height: 24px;
}

QPushButton#minimizar_button:hover {
    background-color: #CD191E;
    border-radius: 4px;
}

/* --- Sidebar --- */
QFrame#sidebar {
    background-color: #121414;
    border-right: 1px solid #3f4a3d;
}

#sidebar_header {
    border-bottom: 1px solid #3f4a3d;
}

#sidebar_titulo {
    color: #becab9;
    font-family: "Open Sans";
    font-weight: 700;
    letter-spacing: 0.05em;
}

#sidebar_divider {
    border: none;
    border-top: 1px solid #3f4a3d;
    margin: 0 12px;
}

.sidebar_item {
    background-color: transparent;
    color: #becab9;
    border: none;
    border-left: 3px solid transparent;
    font-family: "Open Sans";
    font-weight: 500;
    text-align: left;
}

.sidebar_item:hover {
    background-color: #1e2020;
    border-left-color: #3f4a3d;
    color: #e2e2e2;
}

.sidebar_item[active="true"] {
    background-color: #282a2b;
    border-left-color: #71dd77;
    color: #71dd77;
}

.sidebar_item[active="true"]:hover {
    border-left-color: #71dd77;
}

.sidebar_item:disabled {
    color: #5e7a72;
}

/* --- AnexoPreview --- */
QFrame#anexo_preview {
    background-color: #1e2020;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
}

QLabel#anexo_thumbnail {
    background-color: #000000;
    border: 4px solid #889484;
    border-radius: 4px;
}

QLabel#anexo_metadados {
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 12px;
}

QPushButton#btn_ver_anexos {
    background-color: #2F9E41;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-family: "Open Sans";
    font-size: 12px;
    font-weight: 700;
}

QPushButton#btn_ver_anexos:hover {
    background-color: #37a547;
}

/* --- AnexoGallery --- */
QFrame#anexo_gallery {
    background-color: rgba(0, 0, 0, 179);
}

QFrame#gallery_header_bar {
    background-color: rgba(0, 0, 0, 140);
    min-height: 40px;
}

QLabel#gallery_header_titulo {
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 14px;
    font-weight: 700;
}

QPushButton#gallery_close_button {
    background-color: rgba(255, 255, 255, 30);
    color: #e2e2e2;
    border: 1px solid #5e7a72;
    border-radius: 4px;
    font-size: 18px;
    padding: 4px 14px;
    min-width: 32px;
    min-height: 28px;
}

QPushButton#gallery_close_button:hover {
    background-color: #CD191E;
    color: #ffffff;
    border-color: #CD191E;
}

QPushButton#gallery_prev_button,
QPushButton#gallery_next_button {
    background-color: rgba(0, 0, 0, 100);
    color: #e2e2e2;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
    font-size: 16px;
}

QPushButton#gallery_prev_button:hover,
QPushButton#gallery_next_button:hover {
    background-color: #2F9E41;
}

QLabel#gallery_indicador {
    color: #e2e2e2;
    font-family: "Open Sans";
    font-size: 14px;
    padding: 8px;
}

/* --- MediaViewer --- */
QFrame#media_viewer {
    background-color: rgba(0, 0, 0, 230);
}

/* ============================================================
   TelaDeExpediente — Janela Flutuante do Expediente (z=2)
   ============================================================ */

/* Moldura unica de todas as janelas flutuantes do sistema
   (JanelaFlutuante): como num SO, o estilo da "janela" nunca muda
   entre telas — so o conteudo e as regras de sobreposicao. */
QFrame[janela_flutuante="true"] {
    background-color: #161B22;
    /* Moldura discreta (20% do verde IFF); o verde 100% fica so na
       linha da base da title bar. */
    border: 2px solid rgba(47, 158, 65, 51);
    border-radius: 4px;
}

/* --- PaginaSelecaoPerfil --- */
PaginaSelecaoPerfil #label_selecao_perfil {
    font-family: "Open Sans";
    font-size: 16px;
    color: #E6EDF3;
}

PaginaSelecaoPerfil #label_contador_perfil {
    font-family: "Open Sans";
    font-size: 12px;
    font-weight: 500;
    color: #7777aa;
    padding: 3px 14px;
    background: rgba(22, 27, 34, 0.60);
    border-radius: 4px;
}

/* --- Navegação do Carrossel --- */
#carousel_btn_prev,
#carousel_btn_next {
    font-size: 18px;
    background: rgba(255, 255, 255, 0.06);
    color: #7777aa;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 26px;
}
#carousel_btn_prev:hover,
#carousel_btn_next:hover {
    background: rgba(47, 158, 65, 0.15);
    color: #2F9E41;
    border-color: #2F9E41;
}
#carousel_btn_prev:pressed,
#carousel_btn_next:pressed {
    background: rgba(47, 158, 65, 0.30);
}

/* --- PaginaLoading --- */
PaginaLoading #label_loading_titulo {
    color: #E6EDF3;
    font-family: "Courier New", Consolas, monospace;
    font-size: 16px;
    font-weight: bold;
}

PaginaLoading #label_loading_texto {
    color: #2F9E41;
    font-family: "Courier New", Consolas, monospace;
    font-size: 14px;
    font-weight: bold;
}

PaginaLoading #loading_progress_bar {
    background-color: #30363D;
    border: 1px solid #484F58;
    border-radius: 2px;
    max-height: 16px;
}

PaginaLoading #loading_progress_bar::chunk {
    background-color: #2F9E41;
    border-radius: 2px;
}

/* --- PaginaInspecao: Split-Desk 60/40 --- */
PaginaInspecao #deck_observacao {
    background-color: #1a1c1c;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
    padding: 8px;
}

PaginaInspecao #prancheta {
    background-color: #1e2020;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
    padding: 8px;
}

/* --- PaginaDiagnostico --- */
.diagnostico_header_label {
    font-family: "Open Sans";
    font-size: 11px;
    color: #889484;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
.diagnostico_header_valor {
    font-family: "Open Sans";
    font-size: 34px;
    font-weight: 800;
    color: #71dd77;
}
.diagnostico_card {
    background-color: #1e2020;
    border: 1px solid #3f4a3d;
    border-radius: 4px;
}
.diagnostico_card[decisao_qualidade="otima"] {
    border-left: 3px solid #71dd77;
}
.diagnostico_card[decisao_qualidade="boa"] {
    border-left: 3px solid #d9a824;
}
.diagnostico_card[decisao_qualidade="incorreta"] {
    border-left: 3px solid #ffb4ab;
}
.diagnostico_card_header {
    background-color: #282a2b;
    color: #becab9;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 6px 12px;
}
.diagnostico_card_pontos {
    font-weight: 800;
    color: #71dd77;
}
.diagnostico_total {
    border-top: 1px solid #3f4a3d;
    padding-top: 10px;
}
.diagnostico_total_label {
    font-family: "Open Sans";
    font-size: 13px;
    font-weight: 700;
    color: #e2e2e2;
}
.diagnostico_total_valor {
    font-family: "Open Sans";
    font-size: 13px;
    font-weight: 700;
    color: #71dd77;
}
#btn_continuar_diagnostico {
    background-color: #2F9E41;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 11px;
    font-size: 13px;
    font-weight: 700;
}
#btn_continuar_diagnostico:hover {
    background-color: #37a547;
}
.diagnostico_tile {
    border-radius: 8px;
}
.diagnostico_tile[tile_state="esquecido"] {
    background-color: transparent;
}
.diagnostico_tile_nome {
    font-size: 11px;
    color: #e2e2e2;
}
.diagnostico_tile_score {
    font-size: 12px;
    font-weight: 700;
}
.diagnostico_tempo_label {
    font-size: 11px;
    color: #889484;
    padding: 10px 14px;
}
.diagnostico_decisao_resultado {
    font-size: 10px;
    padding: 6px 0 10px;
}
.diagnostico_decisao_opcao {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.05em;
    border-radius: 4px;
    min-width: 80px;
}
.diagnostico_decisao_opcao QLabel {
    color: #5f5e5a;
}
.diagnostico_decisao_opcao[decisao_state="nao_escolhida"] {
    border: 2px solid #3f4a3d;
    background-color: transparent;
}
.diagnostico_decisao_opcao[decisao_state="escolhida"] QLabel {
    color: #ffffff;
}
.diagnostico_decisao_opcao[decisao_state="correta_nao_escolhida"] {
    background-color: transparent;
}

/* --- GameWin / GameOver --- */
GameWin {
    background-color: #1a1d21;
    border: 2px solid #3a3f47;
    border-radius: 8px;
}

GameWin #label_endgame_titulo {
    font-family: "Courier New", Consolas, monospace;
    font-size: 24px;
    font-weight: bold;
    border: 2px solid;
    border-radius: 4px;
    padding: 16px;
}

GameWin #label_endgame_titulo {
    color: #2F9E41;
    border-color: #2F9E41;
    background-color: #0a1a0a;
}

GameOver #label_endgame_titulo {
    color: #CD191E;
    border-color: #CD191E;
    background-color: #1a0a0a;
}

GameWin #label_endgame_pontuacao {
    color: #E6EDF3;
    font-family: "Courier New", Consolas, monospace;
    font-size: 16px;
    padding: 8px;
}

/* ——— CRT GameWin ——— */
GameWin {
    background-color: #0a0a0a;
    border: 6px solid #1a1c1c;
    border-radius: 14px;
}

GameWin #gamewin_header {
    color: #71dd77;
}

GameWin #gamewin_timestamp {
    color: #889484;
}

GameWin #gamewin_titulo {
    color: #71dd77;
}

GameWin #gamewin_subtitulo {
    color: #8dfa91;
}

GameWin #gamewin_card {
    background-color: #eeeae2;
    border-radius: 2px;
}

GameWin QFrame#gamewin_card {
    background-image: url(icons/fim_jogo/oldpaper.png);
    background-color: #eeeae2;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    border-radius: 2px;
}

GameWin #gamewin_card_cabecalho {
    color: #5f5e5a;
}

GameWin #gamewin_card_subcabecalho {
    color: #1a1c1c;
}

GameWin #gamewin_card_divider {
    background-color: #1a1c1c;
}

GameWin #gamewin_card_parecer_num {
    color: #5f5e5a;
}

GameWin QScrollArea {
    background-color: transparent;
}

GameWin #gamewin_card_parecer_texto {
    background-color: transparent;
    color: #1a1c1c;
}

GameWin #gamewin_score_label {
    color: #889484;
}

GameWin #gamewin_score_valor {
    color: #8dfa91;
}

GameWin #gamewin_btn_retry {
    background-color: #2F9E41;
    color: #ffffff;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 6px;
    border: none;
}

GameWin #gamewin_btn_retry:hover {
    background-color: #3cb350;
}

GameWin #gamewin_btn_retry:focus {
    background-color: #2a8a37;
    border: 2px solid #ffffff;
}

GameWin #gamewin_btn_retry:pressed {
    background-color: #1e6b28;
}

GameWin #gamewin_btn_menu {
    background-color: transparent;
    color: #889484;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 6px;
    border: 1px solid #3f4a3d;
}

GameWin #gamewin_btn_menu:hover {
    border-color: #6f7a6d;
    color: #c0c4c0;
}

GameWin #gamewin_btn_menu:focus {
    border: 2px solid #ffffff;
    color: #e0e4e0;
}

GameWin #gamewin_btn_menu:pressed {
    background-color: #2a302a;
    border-color: #8f9a8d;
}

GameWin #gamewin_btn_quit {
    background-color: transparent;
    color: #71dd77;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 6px;
    border: 1px solid #3f5a3d;
}

GameWin #gamewin_btn_quit:hover {
    border-color: #71dd77;
    color: #8dfa91;
}

GameWin #gamewin_btn_quit:focus {
    border: 2px solid #71dd77;
    color: #8dfa91;
}

GameWin #gamewin_btn_quit:pressed {
    background-color: #1a2a1a;
    border-color: #71dd77;
}

/* ——— CRT GameOver ——— */
GameOver {
    background-color: #0a0a0a;
    border: 6px solid #1a1c1c;
    border-radius: 14px;
}

GameOver #gameover_header {
    color: #71dd77;
}

GameOver #gameover_timestamp {
    color: #889484;
}

GameOver #gameover_titulo {
    color: #CD191E;
}

GameOver #gameover_subtitulo {
    color: #ffb4ab;
}

GameOver #gameover_card {
    background-color: #eeeae2;
    border-radius: 2px;
}

GameOver QFrame#gameover_card {
    background-image: url(icons/fim_jogo/oldpaper.png);
    background-color: #eeeae2;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    border-radius: 2px;
}

GameOver #gameover_card_cabecalho {
    color: #5f5e5a;
}

GameOver #gameover_card_subcabecalho {
    color: #1a1c1c;
}

GameOver #gameover_card_divider {
    background-color: #1a1c1c;
}

GameOver #gameover_card_parecer_num {
    color: #5f5e5a;
}

GameOver QScrollArea {
    background-color: transparent;
}

GameOver #gameover_card_parecer_texto {
    background-color: transparent;
    color: #1a1c1c;
}

GameOver #gameover_score_label {
    color: #889484;
}

GameOver #gameover_score_valor {
    color: #ffb4ab;
}

GameOver #gameover_btn_retry {
    background-color: #2F9E41;
    color: #ffffff;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 6px;
    border: none;
}

GameOver #gameover_btn_retry:hover {
    background-color: #3cb350;
}

GameOver #gameover_btn_retry:focus {
    background-color: #2a8a37;
    border: 2px solid #ffffff;
}

GameOver #gameover_btn_retry:pressed {
    background-color: #1e6b28;
}

GameOver #gameover_btn_menu {
    background-color: transparent;
    color: #889484;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 6px;
    border: 1px solid #3f4a3d;
}

GameOver #gameover_btn_menu:hover {
    border-color: #6f7a6d;
    color: #c0c4c0;
}

GameOver #gameover_btn_menu:focus {
    border: 2px solid #ffffff;
    color: #e0e4e0;
}

GameOver #gameover_btn_menu:pressed {
    background-color: #2a302a;
    border-color: #8f9a8d;
}

GameOver #gameover_btn_quit {
    background-color: transparent;
    color: #ffb4ab;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 6px;
    border: 1px solid #6f4a4a;
}

GameOver #gameover_btn_quit:hover {
    border-color: #ffb4ab;
    color: #ffcdca;
}

GameOver #gameover_btn_quit:focus {
    border: 2px solid #ffb4ab;
    color: #ffd8d4;
}

GameOver #gameover_btn_quit:pressed {
    background-color: #3a1a1e;
    border-color: #ffb4ab;
}

GameOver #gameover_footer {
    background-color: #1a0708;
    border: 1px solid #4a0709;
    border-radius: 4px;
}

GameOver #gameover_footer_indicator {
    background-color: #CD191E;
}

GameOver #gameover_footer_label {
    color: #ffb4ab;
}

/* ============================================================
   TelaTutorial — Janela Flutuante do Tutorial (z=2, irma do expediente)
   ============================================================ */

/* A moldura da janela do tutorial vem da regra partilhada
   QFrame[janela_flutuante="true"] (padrao TelaDeExpediente). */

QLabel#tutorial_contador {
    color: #8B949E;
    font-family: "Open Sans";
}

QPushButton#tutorial_pular {
    background-color: transparent;
    color: #8B949E;
    border: none;
    font-family: "Open Sans";
}

QPushButton#tutorial_pular:hover {
    color: #E6EDF3;
}

QLabel#tutorial_briefing {
    background-color: #1e2020;
    border-top: 1px solid #2F9E41;
    border-bottom: 1px solid #30363D;
    color: #8B949E;
    font-family: "Open Sans";
}

QPushButton#tutorial_nav_prev,
QPushButton#tutorial_nav_next {
    background-color: #21262D;
    color: #E6EDF3;
    border: 1px solid #484F58;
    border-radius: 50%;
    font-size: 20px;
    font-family: "Open Sans";
}

QPushButton#tutorial_nav_prev:hover,
QPushButton#tutorial_nav_next:hover {
    border-color: #2F9E41;
}

QPushButton#tutorial_nav_prev:disabled,
QPushButton#tutorial_nav_next:disabled {
    background-color: transparent;
    color: #484F58;
    border-color: #30363D;
}

QPushButton#tutorial_dot {
    background-color: #484F58;
    border: none;
    border-radius: 50%;
}

QPushButton#tutorial_dot[active="true"] {
    background-color: #2F9E41;
}

QPushButton#tutorial_cta {
    background-color: #2F9E41;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-family: "Open Sans";
    padding: 13px 26px;
}

QPushButton#tutorial_cta:hover {
    background-color: #71dd77;
    color: #121414;
}

QPushButton#tutorial_cta:pressed {
    background-color: #238636;
    color: #FFFFFF;
}

QPushButton#tutorial_cta:focus {
    border: 1px solid #71dd77;
}

QLabel#tutorial_eyebrow {
    color: #71dd77;
    font-size: 14px;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_titulo {
    color: #E6EDF3;
    font-size: 22px;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_paragrafo {
    color: #8B949E;
    font-size: 14px;
    font-family: "Open Sans";
}

QLabel#tutorial_aviso {
    color: #8B949E;
    font-size: 13px;
    font-style: italic;
    font-family: "Open Sans";
}

QWidget#tutorial_riscos_grupo QToolButton[riscoTile="true"] {
    min-width: 98px;
    min-height: 90px;
}

QFrame#tutorial_credential {
    background-color: #eeeae2;
    border: 1px solid #B9B4A8;
    border-radius: 8px;
}

QFrame#credential_selo {
    background-color: #121414;
    border: 2px solid #B9B4A8;
    border-radius: 50%;
}

QLabel#credential_selo_icone {
    background-image: url(icons/tutorial/pessoa.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 50%;
}

QLabel#credential_nome {
    color: #1a1c1c;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#credential_cargo {
    color: #6b6b66;
    font-family: "Open Sans";
}

QLabel#credential_logo {
    background-image: url(icons/iff_Icons/logo-iff.png);
    background-repeat: no-repeat;
    background-position: center;
}

QFrame#credential_separador {
    background-color: #B9B4A8;
    border: none;
}

QLabel#tutorial_item_num {
    background-color: #2F9E41;
    color: #FFFFFF;
    border-radius: 50%;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_item_titulo {
    color: #E6EDF3;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_item_descricao {
    color: #8B949E;
    font-family: "Open Sans";
}

QFrame#tutorial_mini_relatorio {
    background-color: #eeeae2;
    border: 1px solid #B9B4A8;
    border-radius: 8px;
}

QLabel#tutorial_relatorio_titulo {
    color: #1a1c1c;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_relatorio_campo {
    color: #8a8475;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_relatorio_valor {
    color: #1a1c1c;
    font-family: "Open Sans";
}

QFrame[class="tutorial_fator_tile"] {
    background-color: #1e2020;
    border: 1px solid #3f4a3d;
    border-radius: 8px;
}

QLabel#tutorial_fator_titulo {
    color: #E6EDF3;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_fator_subtitulo {
    color: #8B949E;
    font-family: "Open Sans";
}

QFrame#tutorial_exemplo {
    background-color: #121414;
    border: 1px solid #3f4a3d;
    border-radius: 8px;
}

QLabel#tutorial_exemplo_titulo {
    color: #71dd77;
    font-weight: bold;
    font-family: "Open Sans";
}

QLabel#tutorial_exemplo_linha {
    color: #8B949E;
    font-family: "Open Sans";
}

QFrame#tutorial_carimbo {
    border-radius: 50%;
}

QFrame#tutorial_carimbo[estado="marcado"] {
    background-color: #2F9E41;
    border: 2px solid #71dd77;
}

QFrame#tutorial_carimbo[estado="vazio"] {
    background-color: #1e2020;
    border: 2px dashed #3f4a3d;
}

QFrame#tutorial_carimbo[estado="marcado"] QLabel#tutorial_carimbo_nome {
    color: #FFFFFF;
    font-family: "Open Sans";
}

QFrame#tutorial_carimbo[estado="vazio"] QLabel#tutorial_carimbo_nome {
    color: #8B949E;
    font-family: "Open Sans";
}

QLabel#tutorial_decisao_legenda {
    color: #8B949E;
    font-style: italic;
    font-family: "Open Sans";
}

QFrame#tutorial_mini_tela {
    border-radius: 8px;
}

QFrame#tutorial_mini_tela[estado="win"] {
    background-color: #14321b;
    border: 1px solid #37a547;
}

QFrame#tutorial_mini_tela[estado="over"] {
    background-color: #3a1416;
    border: 1px solid #bb0213;
}

QLabel#tutorial_mini_tela_titulo {
    font-weight: bold;
    font-family: "Open Sans";
}

QFrame#tutorial_mini_tela[estado="win"] QLabel#tutorial_mini_tela_titulo {
    color: #71dd77;
}

QFrame#tutorial_mini_tela[estado="over"] QLabel#tutorial_mini_tela_titulo {
    color: #ffb4ab;
}

QLabel#tutorial_mini_tela_subtitulo {
    color: #8B949E;
    font-family: "Open Sans";
}
